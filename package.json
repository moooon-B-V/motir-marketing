{
  "name": "motir-marketing",
  "version": "0.0.0",
  "private": true,
  "description": "The Motir marketing site — motir.co. GPL-3.0.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:design": "vitest run --config vitest.design.config.mts",
    "test:e2e": "playwright test",
    "test:seam": "vitest run --config vitest.seam.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:icons": "node scripts/brand/generate-brand-icons.ts",
    "brand:og-fonts": "node scripts/brand/subset-og-fonts.ts",
    "design:render": "node scripts/design/render-design-mock.ts",
    "i18n:extract": "node scripts/i18n/catalogue.ts extract",
    "i18n:merge": "node scripts/i18n/catalogue.ts merge",
    "i18n:status": "node scripts/i18n/catalogue.ts status",
    "i18n:baseline": "node scripts/i18n/catalogue.ts baseline",
    "i18n:glossary-sync": "node scripts/i18n/catalogue.ts glossary-sync"
  },
  "dependencies": {
    "@motir/brand": "0.4.4",
    "@motir/design-system": "0.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "4.14.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.19",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "opentype.js": "1.3.4",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "sharp": "0.34.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
